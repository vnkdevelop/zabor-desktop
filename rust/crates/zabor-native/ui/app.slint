        AvatarCropper { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.crop-image;
            scale <=> root.crop-scale; offset-x <=> root.crop-x; offset-y <=> root.crop-y; busy: root.avatar-loading; reduced-motion: root.reduced-motion;
            tr(key) => { return root.tr(key, root.language); } cancel => { root.cancel-crop(); } apply => { root.apply-crop(); }
        }
    }
}
