import { FormButton, FormField, IconButton, ControlMotion } from "controls.slint";
import { ScrollView } from "std-widgets.slint";
import { AudioSettingsPanel, AudioSettingsView, AudioDeviceItem, AudioSlider, AudioToggle, RelaySetting, StreamAudioSetting } from "audio-settings.slint";
import { MicTestPanel, MicTestView, MicButtonFeedback } from "mic-test.slint";
import { StreamSource } from "stream-source.slint";
import { RemoteViewer } from "remote-viewer.slint";
import { AvatarCropper } from "avatar-cropper.slint";
import { AchievementsPanel, AchievementItem } from "achievements.slint";
export { AchievementItem }

export struct ChannelItem { id: string, name: string, count: int }
export struct FriendItem { id: string, name: string, username: string, online: bool, color: color, avatar: image, speaking: bool, muted: bool, deafened: bool }
export struct ChatLine { id: string, text: string, mine: bool, delivery: string, file: bool, size-text: string, size-unit: string, transfer: string, progress: int, cached: bool, saved: bool }
export struct ScreenItem { id: string, title: string, thumbnail: image }
export struct VideoItem { id: string, title: string, frame: image }
export struct NotificationItem { id: string, kind: int, name: string, sender: string, color: color, avatar: image }

component ProfileOriginButton inherits IconButton {
    in property <string> origin;
    in property <string> source;
    in property <string> target;
    in property <string> selected;
    in property <int> restore-reset;
    changed restore-reset => { if root.origin == root.source && root.target == root.selected { root.focus(); } }
}

export component NativeApp inherits Window {
    preferred-width: 1100px; preferred-height: 760px;
    min-width: 720px; min-height: 600px;
    no-frame: true;
    background: #131313;
    default-font-family: "Segoe UI";
    default-font-size: 16px;
    title: root.tr("titlebar.wordmark", root.language);
    in-out property <string> language: "ru";
    in-out property <int> auth-step: 0;
    in-out property <string> login;
    in-out property <string> password;
    in-out property <string> display-name;
    in-out property <string> captcha-answer;
    in-out property <bool> show-password;
    in-out property <bool> busy;
    in-out property <bool> captcha-busy;
    in-out property <string> error;
    in property <image> captcha-image;
    in property <image> setup-avatar;
    in property <color> avatar-color: #c81e70;
    in-out property <bool> avatar-loading;
    in-out property <bool> crop-active;
    in property <image> crop-image;
    in-out property <float> crop-scale: 1;
    in-out property <float> crop-x;
    in-out property <float> crop-y;
    in-out property <string> profile-id;
    in-out property <string> profile-name;
    in-out property <string> profile-login;
    in-out property <string> profile-source: "none";
    in-out property <int> profile-restore-reset;
    in-out property <string> profile-about;
    in property <image> profile-avatar;
    in property <color> profile-color: #c81e70;
    in property <bool> profile-online;
    in property <bool> profile-friend;
    in-out property <bool> profile-editing;
    in-out property <bool> profile-saving;
    in-out property <int> profile-request-status;
    in property <string> profile-presence;
    in property <bool> profile-login-copied;
    in property <[AchievementItem]> achievement-items;
    in property <bool> achievements-loading;
    in property <bool> achievements-own;
    in property <string> achievements-peer-name;
    in property <string> achievements-summary;
    in-out property <int> achievements-focus-reset;
    in property <string> app-feedback;
    in property <[FriendItem]> channel-members;
    in property <string> members-channel-name;
    in property <bool> members-loading;
    in property <bool> member-can-invite;
    in property <bool> member-can-kick;
    in property <bool> member-action-pending;
    in property <bool> member-invited;
    in property <string> member-kick-name;
    in-out property <int> member-kick-focus-reset;
    in-out property <int> members-focus-reset;
    in-out property <int> members-selection;
    in-out property <bool> authenticated;
    in-out property <bool> connected;
    in-out property <int> active-tab;
    in property <[ChannelItem]> channels;
    in property <[FriendItem]> friends;
    in property <[NotificationItem]> notifications;
    in-out property <bool> show-notifications;
    in property <string> user-name;
    in property <string> user-id;
    in property <string> user-login;
    in property <image> user-avatar;
    in property <color> user-color: #c81e70;
    in property <string> joke;
    in property <[ChatLine]> chat-lines;
    in-out property <string> chat-input;
    in property <string> attachment-names;
    in-out property <bool> file-drag;
    in property <[FriendItem]> voice-users;
    in-out property <string> active-channel;
    in-out property <string> pending-channel;
    in-out property <string> pending-channel-name;
    in-out property <bool> voice-active;
    in property <[ScreenItem]> screen-sources;
    in property <[ScreenItem]> window-sources;
    in property <[ScreenItem]> camera-sources;
    in-out property <int> screen-source-kind;
    in-out property <string> screen-quality: "low";
    in-out property <bool> screen-include-audio: true;
    in-out property <bool> screen-allow-control;
    in-out property <bool> screen-sources-loading;
    in-out property <bool> camera-sources-loading;
    private property <[ScreenItem]> picker-sources: root.screen-source-kind == 2 ? root.camera-sources : root.screen-source-kind == 0 ? root.screen-sources : root.window-sources;
    private property <bool> picker-loading: root.screen-source-kind == 2 ? root.camera-sources-loading : root.screen-sources-loading;
    changed screen-source-kind => { root.selected-screen = ""; root.cancel-picker-query(); if root.modal == 5 { if root.screen-source-kind == 2 { root.list-cameras(); } else { root.refresh-screens(); } } }
    in property <[VideoItem]> video-frames;
    in-out property <bool> sharing;
    in-out property <string> selected-screen;
    in-out property <string> focused-video;
    in property <[string]> control-permitted;
    in property <string> control-viewer;
    in property <bool> control-ready;
    in property <bool> control-confined: true;
    in property <bool> control-host-active;
    in property <string> control-controller;
    in-out property <string> incoming-call-id;
    in property <string> incoming-call-name;
    in-out property <bool> muted;
    in-out property <bool> deafened;
    in-out property <int> modal;
    in-out property <string> modal-input;
    in-out property <string> selected-id;
    in property <string> selected-name;
    in property <bool> reduced-motion;
    init => { ControlMotion.reduced-motion = root.reduced-motion; }
    changed reduced-motion => { ControlMotion.reduced-motion = root.reduced-motion; }
    in property <AudioSettingsView> audio-settings;
    in property <[AudioDeviceItem]> input-devices;
    in property <[AudioDeviceItem]> output-devices;
    in property <string> input-device-name;
    in property <string> output-device-name;
    in property <bool> audio-devices-failed;
    in property <float> mic-db: -100;
    in property <MicTestView> mic-test;
    in property <float> mic-test-pulse;
    in property <float> mic-test-dot-pulse;
    in property <float> mic-test-text-scale: 1;
    in property <int> mic-test-focus-reset;
    out property <string> mic-test-focused-control;
    out property <bool> mic-test-focus-outline;
    out property <MicButtonFeedback> mic-test-primary-feedback;
    out property <MicButtonFeedback> mic-test-retake-feedback;
    changed mic-test-focus-reset => { root.mic-test-focused-control = ""; root.mic-test-focus-outline = false; }
    pure callback mic-thumb-spring(float, bool) -> float;
    out property <float> mic-test-thumb-scale: 1;
    out property <bool> mic-test-thumb-animating;
    in-out property <bool> mic-test-revealed;
    out property <bool> mic-test-active: root.authenticated && root.modal == 3 && root.settings-tab == 1 && root.audio-settings.noise-suppression;
    private property <length> test-reserve: root.mic-test-active ? 48px + (root.mic-test.stage == "ready" ? 27px : 0px) + (root.mic-test.issue != "" ? 19.75px : 0px) : 0px;
    out property <length> settings-dialog-y: 36px + (root.height - 36px - min(640px, root.height - 84px - root.test-reserve) - root.test-reserve) / 2;
    out property <length> mic-test-panel-y: root.settings-dialog-y + min(640px, root.height - 84px - root.test-reserve) + 12px;
    in-out property <int> settings-tab;
    in property <bool> open-at-login;
    in property <bool> minimize-to-tray: true;
    in-out property <bool> show-last-online: true;
    in-out property <string> password-input;
    in-out property <string> password-error;
    in-out property <bool> password-pending;
    in-out property <string> delete-confirm-input;
    in-out property <string> delete-error;
    in-out property <bool> delete-pending;
    in-out property <length> settings-scroll-y;
    in-out property <string> volume-peer;
    in-out property <string> volume-name;
    in property <float> peer-volume: 100;
    pure callback tr(string, string) -> string;
    pure callback tr-name(string, string, string) -> string;
    pure callback limit-text(string, int) -> string;
    callback submit-auth;
    callback load-captcha;
    callback choose-avatar;
    callback avatar-context-changed;
    callback cancel-crop;
    callback apply-crop;
    callback open-profile(string);
    callback edit-profile;
    callback cancel-profile-edit;
    callback add-profile-friend;
    callback open-achievements;
    callback close-app-modal;
    callback app-context-changed;
    callback copy-profile-login;
    callback open-channel-members(string);
    callback close-channel-members;
    callback open-member-profile(string);
    callback close-member-profile;
    callback member-profile-action(string);
    callback confirm-member-kick(bool);
    public function copy-username() { clipboard.text = root.profile-login; clipboard.select-all(); clipboard.copy(); }
    clipboard := TextInput { visible: false; }
    callback save-profile;
    callback submit-modal(int, string);
    callback choose-channel(string);
    callback confirm-channel-switch;
    callback choose-friend(string);
    callback logout;
    callback window-action(string);
    callback process-updates;
    callback leave-voice;
    callback audio-state(bool, bool);
    callback language-changed(string);
    callback send-chat(string, string);
    callback choose-files(string);
    callback confirm-files(bool);
    callback file-action(string, string, string);
    callback delete-chat(string, string);
    callback call-friend(string);
    callback answer-call(string, bool);
    callback respond-notification(int, string, bool);
    callback list-screens;
    callback refresh-screens;
    callback list-cameras;
    callback cancel-picker-query;
    callback start-share(string, string, bool, bool);
    callback toggle-control(string);
    callback revoke-control;
    callback release-control;
    callback control-pointer(string, float, float, float, float, int, int);
    callback control-wheel(string, float, float);
    callback control-key(string, string, bool, int);
    callback control-viewport(string, float, float, float, float);
    callback control-confinement(string, bool);
    pure callback control-can-request(string) -> bool;
    callback focus-stream-audio(string);
    changed focused-video => { root.focus-stream-audio(root.focused-video); }
    callback stop-share;
    callback process-video;
    callback audio-setting-changed(string, string);
    callback desktop-setting-changed(string, bool);
    callback change-password(string);
    callback toggle-show-last-online(bool);
    callback delete-account;
    callback refresh-audio-devices;
    callback show-user-volume(string, string);
    callback peer-volume-changed(float);
    callback mic-test-context-changed;
    callback mic-test-record;
    callback mic-test-toggle;
    callback mic-test-seek(float);
    changed language => { root.language-changed(root.language); }
    changed modal => { if root.modal == 3 { root.refresh-audio-devices(); } if root.modal != 5 { root.cancel-picker-query(); } if root.modal != 0 && root.control-viewer != "" { root.release-control(); } root.mic-test-context-changed(); root.avatar-context-changed(); root.app-context-changed(); }
    changed voice-active => { if !root.voice-active { root.cancel-picker-query(); } }
    changed settings-tab => { root.settings-scroll-y = 0px; root.mic-test-context-changed(); }
    changed authenticated => { root.mic-test-context-changed(); root.avatar-context-changed(); root.app-context-changed(); }
    changed user-id => { root.mic-test-context-changed(); root.avatar-context-changed(); root.app-context-changed(); }
    changed auth-step => { root.avatar-context-changed(); }
    changed login => { root.avatar-context-changed(); }
    changed profile-id => { root.avatar-context-changed(); root.app-context-changed(); }
    changed profile-editing => { root.avatar-context-changed(); }
    changed audio-settings => { root.mic-test-context-changed(); }
    changed mic-test-active => { root.mic-test-revealed = false; }

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 36px; background: #191919;
        Rectangle { y: 35px; width: parent.width; height: 1px; background: #ffffff0f; }
        Text { x: 16px; height: 35px; text: root.tr("titlebar.wordmark", root.language); font-size: 13px; font-weight: 900; letter-spacing: 2.6px; color: #ffffff4d; vertical-alignment: center; }
        TouchArea { width: parent.width - 144px; pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.window-action("drag"); } } double-clicked => { root.window-action("maximize"); } }
        HorizontalLayout {
            x: parent.width - 144px; width: 144px; height: 35px; spacing: 0px;
            IconButton { width: 48px; height: 35px; label: root.tr("titlebar.minimize", root.language); activated => { root.window-action("minimize"); } Rectangle { x: 18px; y: 17px; width: 12px; height: 1px; background: #ffffff66; } }
            IconButton { width: 48px; height: 35px; label: root.tr(root.maximized ? "titlebar.restore" : "titlebar.maximize", root.language); activated => { root.window-action("maximize"); } Rectangle { x: 19px; y: 12px; width: 10px; height: 10px; border-radius: 1.5px; border-width: 1px; border-color: #ffffff66; background: transparent; } }
            IconButton { width: 48px; height: 35px; corner-radius: 0px; danger: true; label: root.tr("titlebar.close", root.language); icon: @image-url("../assets/icons/window-close.svg"); activated => { root.window-action("close"); } }
        }
    }
    if !root.authenticated : Rectangle {
        y: 36px; width: parent.width; height: parent.height - 36px; background: transparent;
        auth-card := Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 400px;
            height: root.auth-step == 0 ? 386px + (root.error == "" ? 0px : 36px) : root.auth-step == 1 ? 218px : 482px + (root.error == "" ? 0px : 36px);
            background: #161618c7; border-width: 1px; border-color: #ffffff12; border-radius: 20px;
            if root.auth-step == 0 : VerticalLayout {
                padding: 41px; spacing: 0px;
                Rectangle { height: 40px; background: transparent; Text { x: 0px; y: -4px; width: parent.width; text: root.tr("titlebar.wordmark", root.language); font-size: 36px; font-weight: 900; letter-spacing: 1.8px; color: white; horizontal-alignment: center; height: 40px; } }
                Rectangle { height: 32px; background: transparent; }
                Text { text: root.tr("auth.login", root.language); color: #949ba4; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; height: 16px; }
                Rectangle { height: 8px; background: transparent; }
                login-field := FormField { text <=> root.login; disabled: root.busy; label: root.tr("auth.login", root.language); edited(value) => { root.login = root.limit-text(value, 25); } accepted => { root.submit-auth(); } }
                Rectangle { height: 16px; background: transparent; }
                Text { text: root.tr("auth.password", root.language); color: #949ba4; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; height: 16px; }
                Rectangle { height: 8px; background: transparent; }
                Rectangle {
                    height: 48px; background: transparent;
                    FormField { width: parent.width; text <=> root.password; password: !root.show-password; disabled: root.busy; label: root.tr("auth.password", root.language); edited(value) => { root.password = root.limit-text(value, 25); } accepted => { root.submit-auth(); } }
                    IconButton { x: parent.width - 36px; y: 6px; width: 30px; height: 36px; icon: root.show-password ? @image-url("../assets/icons/eye-off.svg") : @image-url("../assets/icons/eye.svg"); disabled: root.busy; label: root.tr(root.show-password ? "settings.privacy.hidePassword" : "settings.privacy.showPassword", root.language); activated => { root.show-password = !root.show-password; } }
                }
                Rectangle { height: 24px; background: transparent; }
                if root.error != "" : Text { text: root.error; color: #da373c; font-size: 14px; font-weight: 500; horizontal-alignment: center; wrap: word-wrap; height: 36px; }
                FormButton { label: root.tr(root.busy ? "auth.loading" : "auth.continue", root.language); primary: true; disabled: root.busy; reduced-motion: root.reduced-motion; activated => { root.submit-auth(); } }
            }
            if root.auth-step == 1 : VerticalLayout {
                padding: 33px; spacing: 0px;
                Text { text: root.tr("auth.accountNotFound", root.language); font-size: 24px; font-weight: 700; color: white; horizontal-alignment: center; height: 32px; }
                Rectangle { height: 16px; background: transparent; }
                Text { text: root.tr("auth.createNewProfile", root.language); color: #949ba4; wrap: word-wrap; horizontal-alignment: center; height: 24px; }
                Rectangle { height: 32px; background: transparent; }
                HorizontalLayout { spacing: 16px;
                    FormButton { width: (parent.width - 16px) / 2; label: root.tr("auth.no", root.language); activated => { root.auth-step = 0; root.error = ""; } }
                    FormButton { width: (parent.width - 16px) / 2; label: root.tr("auth.yes", root.language); primary: true; activated => { root.auth-step = 2; root.display-name = root.login; root.captcha-answer = ""; root.load-captcha(); } }
                }
            }
            if root.auth-step == 2 : VerticalLayout {
                padding: 33px; spacing: 0px;
                Text { text: root.tr("auth.createProfile", root.language); font-size: 24px; font-weight: 700; color: white; horizontal-alignment: center; height: 32px; }
                Rectangle { height: 4px; background: transparent; }
                Text { text: root.tr("auth.howOthersSeeYou", root.language); font-size: 14px; color: #949ba4; horizontal-alignment: center; height: 20px; }
                Rectangle { height: 20px; background: transparent; }
                Rectangle { height: 88px; background: transparent;
                    Rectangle { x: (parent.width - 88px) / 2; width: 88px; height: 88px; border-radius: 44px; background: root.avatar-color;
                        Image { width: 88px; height: 88px; source: root.setup-avatar; image-fit: cover; }
                        if root.setup-avatar.width == 0 : Image { x: 30px; y: 30px; width: 28px; height: 28px; source: @image-url("../assets/icons/camera.svg"); }
                        IconButton { width: parent.width; height: parent.height; corner-radius: 44px; label: root.tr("auth.cropTitle", root.language); disabled: root.busy || root.avatar-loading; activated => { root.choose-avatar(); } }
                    }
                }
                Rectangle { height: 20px; background: transparent; }
                Text { text: root.tr("auth.displayName", root.language); font-size: 12px; font-weight: 700; color: #949ba4; height: 16px; }
                Rectangle { height: 6px; background: transparent; }
                FormField { text <=> root.display-name; placeholder: root.tr("auth.max20chars", root.language); label: root.tr("auth.displayName", root.language); disabled: root.busy; edited(value) => { root.display-name = root.limit-text(value, 20); } accepted => { root.submit-auth(); } }
                Rectangle { height: 16px; background: transparent; }
                Text { text: root.tr("auth.captcha", root.language); font-size: 12px; font-weight: 700; color: #949ba4; height: 16px; }
                Rectangle { height: 6px; background: transparent; }
                HorizontalLayout { spacing: 8px; height: 52px;
                    FormField { height: 52px; centered: true; text-family: "Consolas"; text-weight: 700; text-spacing: 1.6px; text <=> root.captcha-answer; placeholder: root.tr("auth.captchaPlaceholder", root.language); label: root.tr("auth.captcha", root.language); disabled: root.busy; edited(value) => { root.captcha-answer = root.limit-text(value, 8); } accepted => { root.submit-auth(); } }
                    Rectangle { width: 154px; background: #22222599; border-radius: 16px; border-width: 1px; border-color: #ffffff12;
                        Image { x: 10px; y: 8px; width: 112px; height: 36px; source: root.captcha-image; image-fit: contain; opacity: root.captcha-busy ? 0.3 : 1; }
                        if root.captcha-image.width == 0 : Text { x: 10px; y: 8px; width: 112px; height: 36px; text: root.tr(root.captcha-busy ? "common.loading" : "validation.connectError", root.language); font-size: 12px; color: #949ba4; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                        IconButton { x: 124px; y: 8px; width: 26px; icon: @image-url("../assets/icons/refresh.svg"); label: root.tr("auth.refreshCaptcha", root.language); disabled: root.busy || root.captcha-busy; activated => { root.load-captcha(); } }
                        TouchArea { enabled: !root.busy && !root.captcha-busy; clicked => { root.load-captcha(); } }
                    }
                }
                Rectangle { height: 24px; background: transparent; }
                if root.error != "" : Text { text: root.error; color: #da373c; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; height: 36px; }
                FormButton { label: root.tr(root.busy ? "auth.creating" : "auth.create", root.language); primary: true; disabled: root.busy; activated => { root.submit-auth(); } }
            }
        }
    }
    if root.authenticated : Rectangle {
        y: 36px; width: parent.width; height: parent.height - 36px; background: transparent;
        Rectangle { x: 12px; y: 12px; width: 320px; height: parent.height - 111px; background: #161618b8; border-radius: 18px; border-width: 1px; border-color: #ffffff12;
            if !root.show-notifications : Rectangle { width: parent.width; height: parent.height; background: transparent;
            Text { x: 24px; y: 24px; height: 24px; text: root.tr(root.active-tab == 0 ? "main.voice.voiceChannels" : "main.tabs.friends", root.language); font-size: 12px; font-weight: 700; color: #949ba4; }
            IconButton { x: parent.width - 52px; y: 16px; icon: @image-url("../assets/icons/plus.svg"); label: root.tr(root.active-tab == 0 ? "modals.createChannel.title" : "modals.addFriend.title", root.language); activated => { root.modal = root.active-tab == 0 ? 1 : 2; root.modal-input = ""; root.error = ""; } }
            ScrollView { x: 16px; y: 64px; width: parent.width - 32px; height: parent.height - 132px;
                VerticalLayout { spacing: 8px;
                    for channel in root.channels : Rectangle {
                        visible: root.active-tab == 0;
                        height: 48px; background: channel-touch.has-hover ? #2a2a2ecc : transparent; border-radius: 16px;
                        Rectangle { x: 16px; y: 21px; width: 6px; height: 6px; border-radius: 3px; background: #949ba4; }
                        Text { x: 34px; height: parent.height; width: parent.width - 108px; text: channel.name; font-size: 15px; color: white; overflow: elide; vertical-alignment: center; }
                        Text { x: parent.width - 70px; width: 30px; height: parent.height; text: channel.count > 0 ? channel.count : ""; color: #949ba4; font-size: 12px; vertical-alignment: center; }
                        channel-touch := TouchArea { clicked => { root.choose-channel(channel.id); } }
                        IconButton { x: parent.width - 36px; y: 8px; width: 28px; height: 32px; icon: @image-url("../assets/icons/users.svg"); label: root.tr("contextMenu.channelMembers", root.language); disabled: !root.connected || root.busy; activated => { root.open-channel-members(channel.id); } }
                    }
                    for friend in root.friends : Rectangle {
                        visible: root.active-tab == 1;
                        height: 60px; background: friend-touch.has-hover ? #2a2a2ecc : transparent; border-radius: 16px;
                        Rectangle { x: 8px; y: 7px; width: 46px; height: 46px; border-radius: 23px; background: friend.color;
                            Image { width: 46px; height: 46px; source: friend.avatar; image-fit: cover; }
                            Rectangle { x: 34px; y: 34px; width: 12px; height: 12px; border-radius: 6px; background: friend.online ? #23a559 : #949ba4; border-width: 2px; border-color: #161618; }
                        }
                        Text { x: 66px; y: 9px; width: parent.width - 74px; height: 20px; text: friend.name; color: white; font-size: 14px; font-weight: 700; overflow: elide; }
                        Text { x: 66px; y: 31px; width: parent.width - 74px; height: 16px; text: friend.username; color: #949ba4; font-size: 12px; overflow: elide; }
                        friend-touch := TouchArea { clicked => { root.choose-friend(friend.id); } }
                        ProfileOriginButton { x: 8px; y: 7px; width: 46px; height: 46px; corner-radius: 23px; label: root.tr("contextMenu.profile", root.language); origin: "friends"; source: root.profile-source; target: friend.id; selected: root.profile-id; restore-reset: root.profile-restore-reset; activated => { root.profile-source = "friends"; root.open-profile(friend.id); } }
                    }
                }
            }
            HorizontalLayout { x: 16px; y: parent.height - 56px; width: parent.width - 32px; height: 44px; spacing: 4px;
                FormButton { height: 44px; label: root.tr("main.tabs.channels", root.language); primary: root.active-tab == 0; activated => { root.active-tab = 0; } }
                FormButton { height: 44px; label: root.tr("main.tabs.friends", root.language); primary: root.active-tab == 1; activated => { root.active-tab = 1; } }
            }
            }
            if root.show-notifications : Rectangle { width: parent.width; height: parent.height; background: #161618f0; border-radius: 18px;
                Text { x: 16px; y: 16px; width: parent.width - 72px; height: 36px; text: root.tr("main.notifications.title", root.language); color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                IconButton { x: parent.width - 52px; y: 16px; icon: @image-url("../assets/icons/window-close.svg"); label: root.tr("common.close", root.language); activated => { root.show-notifications = false; } }
                Rectangle { y: 64px; width: parent.width; height: 1px; background: #ffffff12; }
                if root.error != "" : Text { x: 16px; y: 72px; width: parent.width - 32px; height: 48px; text: root.error; color: #da373c; font-size: 13px; wrap: word-wrap; }
                ScrollView { x: 16px; y: root.error == "" ? 80px : 128px; width: parent.width - 32px; height: parent.height - self.y - 16px;
                    VerticalLayout { spacing: 12px;
                        for item in root.notifications : Rectangle { height: item.kind == 0 ? 138px : 130px; background: #222225b3; border-radius: 12px;
                            if item.kind == 0 : Rectangle { x: 16px; y: 16px; width: 47px; height: 47px; background: item.color; border-radius: 24px; Image { width: parent.width; height: parent.height; source: item.avatar; image-fit: cover; } }
                            Text { x: item.kind == 0 ? 75px : 16px; y: 16px; width: parent.width - self.x - 16px; height: 22px; text: item.name; color: white; font-size: 14px; font-weight: 600; overflow: elide; }
                            Text { x: item.kind == 0 ? 75px : 16px; y: 40px; width: parent.width - self.x - 16px; height: 22px; text: item.kind == 0 ? root.tr("main.notifications.friendRequest", root.language) : root.tr-name("main.notifications.channelInvite", item.sender, root.language); color: #949ba4; font-size: 12px; overflow: elide; }
                            HorizontalLayout { x: 16px; y: parent.height - 60px; width: parent.width - 32px; height: 44px; spacing: 8px;
                                FormButton { width: (parent.width - 8px) / 2; height: 44px; border-radius: 12px; background: #23a55933; foreground: #23a559; label-size: 14px; label: root.tr(item.kind == 0 ? "main.notifications.accept" : "main.notifications.join", root.language); disabled: root.busy || !root.connected; activated => { root.respond-notification(item.kind, item.id, true); } }
                                FormButton { width: (parent.width - 8px) / 2; height: 44px; border-radius: 12px; background: #da373c33; foreground: #da373c; label-size: 14px; label: root.tr("main.notifications.decline", root.language); disabled: root.busy || !root.connected; activated => { root.respond-notification(item.kind, item.id, false); } }
                            }
                        }
                        if root.notifications.length == 0 : Rectangle { height: 180px; background: transparent;
                            Image { x: (parent.width - 40px) / 2; y: 48px; width: 40px; height: 40px; source: @image-url("../assets/icons/mail.svg"); opacity: 0.2; }
                            Text { y: 104px; width: parent.width; text: root.tr("main.notifications.none", root.language); color: #949ba4; font-size: 14px; horizontal-alignment: center; }
                        }
                    }
                }
            }
        }
        if root.notifications.length > 0 && !root.show-notifications : Rectangle { x: 252px; y: parent.height - 210px; width: 56px; height: 56px; background: #c81e70e6; border-radius: 28px; border-width: 1px; border-color: #ffffff1a;
            IconButton { width: 56px; height: 56px; corner-radius: 28px; foreground: white; icon: @image-url("../assets/icons/mail.svg"); label: root.tr("main.notifications.title", root.language); activated => { root.show-notifications = true; root.error = ""; } }
            Rectangle { x: 40px; width: 16px; height: 16px; border-radius: 8px; border-width: 2px; border-color: #161618; background: #da373c; }
        }
        Rectangle { x: 12px; y: parent.height - 87px; width: 320px; height: 75px; background: #09090ba0; border-radius: 18px; border-width: 1px; border-color: #ffffff12;
            Rectangle { x: 16px; y: 12px; width: 51px; height: 51px; background: root.user-color; border-radius: 26px;
                Image { width: parent.width; height: parent.height; source: root.user-avatar; image-fit: cover; }
                Rectangle { x: 37px; y: 37px; width: 16px; height: 16px; border-radius: 8px; background: root.connected ? #23a559 : #949ba4; border-width: 3px; border-color: #09090b; }
                ProfileOriginButton { width: parent.width; height: parent.height; corner-radius: 26px; label: root.tr("contextMenu.profile", root.language); origin: "none"; source: root.profile-source; target: root.user-id; selected: root.profile-id; restore-reset: root.profile-restore-reset; activated => { root.profile-source = "none"; root.open-profile(root.user-id); } }
            }
            Text { x: 79px; y: 20px; width: 178px; height: 20px; text: root.user-name; color: white; font-size: 14px; font-weight: 700; overflow: elide; }
            Text { x: 79px; y: 41px; width: 178px; height: 16px; text: root.user-login; color: #949ba4; font-size: 12px; overflow: elide; }
            IconButton { x: 268px; y: 20px; icon: @image-url("../assets/icons/gear.svg"); label: root.tr("settings.title", root.language); activated => { root.settings-tab = 0; root.modal = 3; root.error = ""; } }
        }
        Text { x: 364px; y: 40px; width: parent.width - 400px; height: 120px; text: root.selected-name; font-size: 24px; font-weight: 700; color: white; wrap: word-wrap; }
        if !root.voice-active && (root.active-tab == 0 || root.selected-id == "") : Text { x: 364px; y: 180px; width: parent.width - 400px; height: 180px; text: root.joke; color: #949ba4; wrap: word-wrap; }
        if root.active-tab == 1 && root.selected-id != "" : FormButton { x: parent.width - 144px; y: 32px; width: 120px; height: 40px; label: root.tr("chat.call", root.language); primary: true; disabled: root.busy; activated => { root.call-friend(root.selected-id); } }
        if root.active-tab == 1 && root.selected-id != "" : Rectangle {
            x: 356px; y: 96px; width: parent.width - 380px; height: parent.height - (!root.voice-active ? 120px : 232px); background: transparent;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height - 72px; clip: true; background: transparent;
            ScrollView { x: 0px; y: 0px; width: parent.width; height: parent.height;
                VerticalLayout { spacing: 8px;
                    for message in root.chat-lines : Rectangle {
                        height: message-text.preferred-height + (message.file ? 132px : 44px); border-radius: 16px; background: message.mine ? #ffffff0b : transparent;
                        message-text := Text { x: 16px; y: 12px; width: parent.width - 64px; text: message.text; font-size: 15px; color: #f2f3f5; wrap: word-wrap; }
                        if message.file : Rectangle { x: 16px; y: message-text.y + message-text.preferred-height + 8px; width: parent.width - 32px; height: 88px; background: transparent;
                            Text { x: 0px; y: 0px; width: parent.width; height: 20px; color: #949ba4; font-size: 12px; text: message.size-text + " " + root.tr("chat.units." + message.size-unit, root.language) + (message.transfer == "transferring" ? " · " + message.progress + "%" : message.transfer == "failed" ? " · " + root.tr("chat.file.failed", root.language) : message.transfer == "deleted" ? " · " + root.tr(message.mine ? "chat.file.deletedByYou" : "chat.file.deletedBySender", root.language) : ""); overflow: elide; }
                            if message.transfer == "transferring" : Rectangle { x: 0px; y: 26px; width: parent.width; height: 4px; background: #ffffff12; border-radius: 2px; Rectangle { x: 0px; y: 0px; width: parent.width * message.progress / 100; height: parent.height; background: #c81e70; border-radius: 2px; } }
                            HorizontalLayout { x: 0px; y: 36px; width: parent.width; height: 40px; spacing: 8px; alignment: start;
                                FormButton { height: 40px; width: 120px; label-size: 13px; label: root.tr(message.transfer == "transferring" ? "chat.cancel" : message.saved ? "chat.openFile" : message.cached ? "chat.saveFile" : "chat.download", root.language); disabled: message.transfer != "transferring" && !message.cached && !message.saved && (message.mine || !root.connected || message.transfer == "deleted"); activated => { root.file-action(root.selected-id, message.id, message.transfer == "transferring" ? "cancel" : message.saved ? "reveal" : "save"); } }
                                if message.cached : FormButton { height: 40px; width: 120px; label-size: 13px; label: root.tr("chat.clearFile", root.language); activated => { root.file-action(root.selected-id, message.id, "clear"); } }
                            }
                        }
                        Text { x: 16px; y: parent.height - 24px; height: 16px; text: message.mine ? root.tr("chat.delivery." + message.delivery, root.language) : ""; font-size: 11px; color: #949ba4; }
                        IconButton { x: parent.width - 36px; y: 8px; width: 28px; height: 28px; icon: @image-url("../assets/icons/window-close.svg"); label: root.tr("chat.deleteMessage", root.language); activated => { root.delete-chat(root.selected-id, message.id); } }
                    }
                }
            }
            }
            HorizontalLayout { y: parent.height - 56px; width: parent.width; height: 48px; spacing: 12px;
                IconButton { width: 44px; height: 48px; icon: @image-url("../assets/icons/paperclip.svg"); label: root.tr("chat.attach", root.language); activated => { root.choose-files(root.selected-id); } }
                FormField { text <=> root.chat-input; label: root.tr("chat.placeholder", root.language); placeholder: root.tr("chat.placeholder", root.language); accepted => { root.send-chat(root.selected-id, root.chat-input); } }
                FormButton { width: 112px; label: root.tr("chat.sendFile", root.language); primary: true; activated => { root.send-chat(root.selected-id, root.chat-input); } }
            }
            if root.file-drag : Rectangle { width: parent.width; height: parent.height; border-radius: 16px; border-width: 2px; border-color: #c81e70; background: #161618ee; Text { width: parent.width; height: parent.height; text: root.tr("chat.dropToSend", root.language); font-size: 20px; color: white; horizontal-alignment: center; vertical-alignment: center; } }
        }
        if root.voice-active && root.active-tab == 0 : Rectangle {
            x: 356px; y: 96px; width: parent.width - 380px; height: parent.height - 240px; background: transparent;
            HorizontalLayout { spacing: 16px; alignment: center;
                for user in root.voice-users : Rectangle {
                    width: min(280px, (parent.width - 16px * (root.voice-users.length - 1)) / max(1, root.voice-users.length));
                    height: self.width; y: (parent.height - self.height) / 2;
                    background: #161618b8; border-radius: 24px; border-width: 1px; border-color: #ffffff12;
                    Rectangle { x: (parent.width - 96px) / 2; y: (parent.height - 128px) / 2; width: 96px; height: 96px; background: user.color; border-radius: 48px;
                        Image { width: 96px; height: 96px; source: user.avatar; image-fit: cover; }
                        Rectangle { width: parent.width; height: parent.height; border-radius: 48px; border-width: user.speaking && !user.muted ? 2px : 0px; border-color: #3ba55c; background: transparent; }
                        ProfileOriginButton { width: parent.width; height: parent.height; corner-radius: 48px; label: root.tr("contextMenu.profile", root.language); origin: "voiceUsers"; source: root.profile-source; target: user.id; selected: root.profile-id; restore-reset: root.profile-restore-reset; activated => { root.profile-source = "voiceUsers"; root.open-profile(user.id); } }
                    }
                    if user.muted || user.deafened : Image { x: parent.width - 36px; y: 16px; width: 20px; height: 20px; source: user.deafened ? @image-url("../assets/icons/headphones.svg") : @image-url("../assets/icons/microphone.svg"); colorize: #da373c; }
                    if user.id != root.user-id : IconButton { x: 12px; y: 12px; width: 44px; height: 44px; icon: @image-url("../assets/icons/headphones.svg"); label: root.tr("modals.userVolume.title", root.language); activated => { root.show-user-volume(user.id, user.name); } }
                    Text { x: 12px; y: (parent.height + 88px) / 2; width: parent.width - 24px; height: 24px; text: user.name; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; overflow: elide; }
                }
            }
        }
        if root.voice-active && root.video-frames.length > 0 : Rectangle {
            x: 356px; y: 96px; width: parent.width - 380px; height: parent.height - 224px; background: #09090b; border-radius: 18px;
            HorizontalLayout { spacing: 12px;
                for video in root.video-frames : Rectangle {
                    visible: root.focused-video == "" || root.focused-video == video.id;
                    background: #09090b; border-width: 1px; border-color: #ffffff12; border-radius: 18px;
                    RemoteViewer {
                        y: 36px; width: parent.width; height: parent.height - 36px; frame: video.frame;
                        active: root.control-ready && root.control-viewer == video.id && root.modal == 0 && root.focused-video == video.id;
                        confined: root.control-confined;
                        init => { self.viewport(self.viewport-x, self.viewport-y, self.viewport-width, self.viewport-height); }
                        activate => { root.focused-video = root.focused-video == video.id ? "" : video.id; }
                        pointer(x, y, width, height, kind, button) => { root.control-pointer(video.id, x, y, width, height, kind, button); }
                        wheel(y, x) => { root.control-wheel(video.id, y, x); }
                        key(text, down, modifiers) => { root.control-key(video.id, text, down, modifiers); }
                        viewport(x, y, width, height) => { root.control-viewport(video.id, x, y, width, height); }
                        confinement(confined) => { root.control-confinement(video.id, confined); }
                        release => { root.release-control(); }
                    }
                    Text { x: 16px; height: 36px; text: video.title; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    if root.focused-video == video.id && root.control-can-request(video.id) : IconButton {
                        x: parent.width - 44px; width: 44px; height: 36px; icon: @image-url("../assets/icons/desktop.svg");
                        label: root.tr(root.control-viewer == video.id ? "stream.remoteControlRelease" : "stream.remoteControlCapture", root.language);
                        foreground: root.control-viewer == video.id ? #ee68a9 : white;
                        activated => { root.toggle-control(video.id); }
                    }
                }
            }
        }
        if root.voice-active : Rectangle {
            x: 344px + (parent.width - 344px - 412px) / 2; y: parent.height - 112px; width: 412px; height: 88px;
            background: #161618b3; border-radius: 44px; border-width: 1px; border-color: #ffffff12;
            HorizontalLayout { padding: 16px; spacing: 16px;
                IconButton { width: 56px; height: 56px; icon: @image-url("../assets/icons/microphone.svg"); foreground: root.muted ? #da373c : white; label: root.tr(root.muted ? "main.voice.unmute" : "main.voice.mute", root.language); activated => { root.muted = !root.muted; root.audio-state(root.muted, root.deafened); } }
                IconButton { width: 56px; height: 56px; icon: @image-url("../assets/icons/headphones.svg"); foreground: root.deafened ? #da373c : white; label: root.tr(root.deafened ? "main.voice.undeafen" : "main.voice.deafen", root.language); activated => { root.deafened = !root.deafened; root.audio-state(root.muted, root.deafened); } }
                IconButton { width: 56px; height: 56px; icon: @image-url("../assets/icons/desktop.svg"); foreground: root.sharing ? #ee68a9 : white; label: root.tr(root.sharing ? "stream.stopHint" : "stream.pickerTitle", root.language); activated => { if root.sharing { root.stop-share(); } else { root.list-screens(); } } }
                FormButton { height: 56px; label: root.tr("main.voice.endCall", root.language); primary: true; activated => { root.leave-voice(); } }
            }
        }
        if root.voice-active && root.control-controller != "" : FormButton {
            x: 356px; y: parent.height - 172px; width: min(500px, parent.width - 380px); height: 44px;
            label: root.tr("stream.revokeRemoteControlHint", root.language);
            primary: true;
            activated => { root.revoke-control(); }
        }
    }
    if root.authenticated && root.error != "" && root.modal == 0 : Rectangle { x: 356px; y: parent.height - 170px; width: parent.width - 380px; height: 44px; background: #09090be6; border-radius: 12px; Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.error; font-size: 14px; color: #da373c; wrap: word-wrap; vertical-alignment: center; } TouchArea { clicked => { root.error = ""; } } }
    if root.modal == 3 : Rectangle {
        y: 36px; width: parent.width; height: parent.height - 36px; background: #000000b3;
        test-panel := MicTestPanel { x: (parent.width - self.width) / 2; y: settings-dialog.y + settings-dialog.height + 12px + self.slide; test: root.mic-test; active: root.mic-test-active && (root.reduced-motion || root.mic-test-revealed); reduced-motion: root.reduced-motion; pulse: root.mic-test-pulse; dot-pulse: root.mic-test-dot-pulse;
            text-scale: root.mic-test-text-scale; screen-y: 36px + self.y;
            focus-reset: root.mic-test-focus-reset;
            focus-updated(control, focused, outline) => {
                if focused { root.mic-test-focused-control = control; root.mic-test-focus-outline = outline; }
                if !focused && root.mic-test-focused-control == control { root.mic-test-focused-control = ""; root.mic-test-focus-outline = false; }
            }
            thumb-updated(scale, running) => { root.mic-test-thumb-scale = scale; root.mic-test-thumb-animating = running; }
            feedback-updated(control, feedback) => {
                if control == "primary" { root.mic-test-primary-feedback = feedback; }
                if control == "retake" { root.mic-test-retake-feedback = feedback; }
            }
            private property <length> slide: root.mic-test-active && (root.reduced-motion || root.mic-test-revealed) ? 0px : -self.height - 32px;
            opacity: root.mic-test-active && (root.reduced-motion || root.mic-test-revealed) ? 1 : 0;
            animate opacity, slide { duration: root.reduced-motion ? 0ms : 420ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            tr(key) => { return root.tr(key, root.language); }
            spring(progress, pop) => { return root.mic-thumb-spring(progress, pop); }
            record => { root.mic-test-record(); }
            toggle-playback => { root.mic-test-toggle(); }
            seek(seconds) => { root.mic-test-seek(seconds); }
        }
        settings-dialog := Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height - root.test-reserve) / 2; width: 500px; height: min(640px, parent.height - 48px - root.test-reserve); background: #161618f0; border-radius: 20px; border-width: 1px; border-color: #ffffff12;
            animate y, height { duration: root.reduced-motion ? 0ms : 420ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            Text { x: 24px; y: 24px; width: parent.width - 88px; height: 28px; text: root.tr("settings.title", root.language); color: white; font-size: 20px; font-weight: 700; }
            IconButton { x: parent.width - 64px; y: 16px; width: 44px; height: 44px; icon: @image-url("../assets/icons/window-close.svg"); label: root.tr("common.close", root.language); activated => { root.modal = 0; root.mic-test-context-changed(); } }
            HorizontalLayout { x: 24px; y: 68px; width: parent.width - 48px; height: 40px; spacing: 8px;
                for tab[index] in ["settings.tabs.general", "settings.tabs.audio", "settings.tabs.privacy", "settings.tabs.account"] : FormButton { height: 40px; label-size: 13px; label: root.tr(tab, root.language); primary: root.settings-tab == index; activated => { root.settings-tab = index; } }
            }
            Rectangle { x: 0px; y: 124px; width: parent.width; height: 1px; background: #ffffff12; }
            ScrollView { x: 24px; y: 140px; width: parent.width - 48px; height: parent.height - 164px; content-y <=> root.settings-scroll-y;
                VerticalLayout { spacing: 24px;
                    if root.settings-tab == 0 : VerticalLayout { spacing: 12px;
                        Text { text: root.tr("settings.general.system", root.language); color: white; font-size: 15px; font-weight: 600; }
                        AudioToggle { label: root.tr("settings.general.autoLaunch", root.language); hint: root.tr("settings.general.autoLaunchDesc", root.language); checked: root.open-at-login; reduced-motion: root.reduced-motion; toggled(value) => { root.desktop-setting-changed("openAtLogin", value); } }
                        AudioToggle { label: root.tr("settings.general.minimizeToTray", root.language); hint: root.tr("settings.general.minimizeToTrayDesc", root.language); checked: root.minimize-to-tray; reduced-motion: root.reduced-motion; toggled(value) => { root.desktop-setting-changed("minimizeToTray", value); } }
                        Text { text: root.tr("settings.general.language", root.language); color: white; font-size: 15px; font-weight: 600; }
                        Text { text: root.tr("settings.general.languageDesc", root.language); color: #949ba4; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout { spacing: 12px;
                            FormButton { label: root.tr("settings.general.languageRussian", root.language); primary: root.language == "ru"; activated => { root.language = "ru"; } }
                            FormButton { label: root.tr("settings.general.languageEnglish", root.language); primary: root.language == "en"; activated => { root.language = "en"; } }
                        }
                    }
                    if root.settings-tab == 1 : AudioSettingsPanel { audio: root.audio-settings; inputs: root.input-devices; outputs: root.output-devices; input-name: root.input-device-name; output-name: root.output-device-name; reduced-motion: root.reduced-motion; devices-failed: root.audio-devices-failed; mic-db: root.mic-db; tr(key) => { return root.tr(key, root.language); } edited(key, value) => { root.audio-setting-changed(key, value); } }
                    if root.settings-tab == 2 : VerticalLayout { spacing: 16px;
                        Text { text: root.tr("settings.privacy.visibility", root.language); color: white; font-size: 15px; font-weight: 600; }
                        AudioToggle { label: root.tr("settings.privacy.showLastOnline", root.language); checked: root.show-last-online; disabled: !root.connected; reduced-motion: root.reduced-motion; toggled(value) => { root.toggle-show-last-online(value); } }
                        RelaySetting { relay-only: root.audio-settings.relay-only; reduced-motion: root.reduced-motion; tr(key) => { return root.tr(key, root.language); } toggled(value) => { root.audio-setting-changed("relayOnly", value ? "true" : "false"); } }
                        Text { text: root.tr("settings.privacy.changePasswordTitle", root.language); color: white; font-size: 15px; font-weight: 600; }
                        FormButton { label: root.tr("settings.privacy.changePassword", root.language); activated => { root.password-input = ""; root.password-error = ""; root.modal = 13; } }
                        FormButton { label: root.tr("settings.privacy.deleteAccount", root.language); foreground: #da373c; activated => { root.delete-confirm-input = ""; root.delete-error = ""; root.modal = 14; } }
                    }
                    if root.settings-tab == 3 : VerticalLayout { spacing: 12px;
                        FormButton { label: root.tr("profile.editTitle", root.language); activated => { root.profile-source = "none"; root.open-profile(root.user-id); root.edit-profile(); } }
                        FormButton { label: root.tr("settings.privacy.logout", root.language); foreground: #da373c; activated => { root.logout(); } }
                    }
                    if root.error != "" : Text { text: root.error; color: #da373c; font-size: 14px; wrap: word-wrap; }
                }
            }
