export struct MicTestView {
    stage: string, issue: string, playing: bool, duration: float, position: float,
}

export struct MicButtonFeedback {
    pointer-pressed: bool, space-held: bool, scale: float, outline-scale: float, disabled: bool,
}

component MicFocusScope inherits FocusScope {
    in property <string> control;
    in property <int> focus-reset;
    private property <bool> keyboard-focus;
    private property <bool> focused;
    out property <bool> outline-visible: self.enabled && root.focused && root.keyboard-focus;
    focus-on-click: false;
    public function pointer-focus() {
        if !root.focused { root.keyboard-focus = false; }
        self.focus();
    }
    focus-gained(reason) => {
        root.focused = true;
        if reason == FocusReason.tab-navigation { root.keyboard-focus = true; }
        if reason == FocusReason.pointer-click { root.keyboard-focus = false; }
    }
    focus-lost(reason) => { root.focused = false; }
    capture-key-pressed(event) => {
        if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta { root.keyboard-focus = true; }
        return reject;
    }
    callback focus-updated(string, bool, bool);
    changed focused => { root.focus-updated(root.control, self.enabled && root.focused, root.outline-visible); }
    changed enabled => {
        if !self.enabled { self.clear-focus(); root.focused = false; root.keyboard-focus = false; }
        root.focus-updated(root.control, self.enabled && root.focused, root.outline-visible);
    }
    changed outline-visible => { root.focus-updated(root.control, self.enabled && root.focused, root.outline-visible); }
    changed focus-reset => { self.clear-focus(); root.focused = false; root.keyboard-focus = false; }
}

component TestButton inherits Rectangle {
    in property <string> label;
    in property <bool> disabled;
    in property <bool> reduced-motion;
    in property <bool> primary;
    in property <bool> recording;
    in property <float> pulse;
    in property <float> dot-pulse;
    in property <length> label-top;
    in property <string> control;
    in property <int> focus-reset;
    callback focus-updated(string, bool, bool);
    private property <bool> space-held;
    private property <bool> pointer-active;
    private property <float> visual-scale: root.disabled && !root.reduced-motion ? 1 + root.pulse * 0.03 : root.primary && !root.disabled && (root.pointer-active || root.space-held) ? 0.99 : 1;
    private property <float> outline-scale: root.visual-scale;
    changed disabled => { if root.disabled { root.pointer-active = false; } }
    private property <MicButtonFeedback> feedback: { pointer-pressed: touch.pressed, space-held: root.space-held, scale: root.visual-scale, outline-scale: root.outline-scale, disabled: root.disabled };
    callback feedback-updated(string, MicButtonFeedback);
    changed feedback => { root.feedback-updated(root.control, root.feedback); }
    init => { root.feedback-updated(root.control, root.feedback); }
    callback activated;
    height: 36px;
    background: transparent;
    Rectangle { width: root.width; height: root.height;
        border-radius: root.primary ? 16px : 8px;
        background: root.disabled ? #c81e7033 : root.primary ? (touch.has-hover ? #de217c : #c81e70e6) : touch.has-hover ? #ffffff17 : #161618b3;
        border-width: root.primary ? 0px : 1px;
        border-color: #ffffff0f;
        transform-scale-x: root.visual-scale;
        transform-scale-y: root.visual-scale;
        transform-origin: { x: root.width / 2, y: root.height / 2 };
        HorizontalLayout { alignment: center; spacing: 6px;
        if root.recording : Rectangle { width: 8px; background: transparent;
            Rectangle { x: 0px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px; background: #de217c;
                opacity: root.reduced-motion ? 1 : 1 - root.dot-pulse * 0.6;
                transform-scale-x: root.reduced-motion ? 1 : 1 + root.dot-pulse * 0.55;
                transform-scale-y: root.reduced-motion ? 1 : 1 + root.dot-pulse * 0.55;
                transform-origin: { x: 4px, y: 4px };
            }
        }
            if root.primary : Text { text: root.label; color: root.disabled ? #ee68a9 : white; font-size: 12px; font-family: "Segoe UI"; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
            if !root.primary : Rectangle { background: transparent; preferred-width: label.preferred-width;
                label := Text { y: root.label-top; height: self.preferred-height; width: parent.width; text: root.label; color: touch.has-hover ? white : #949ba4; font-size: 10px; font-family: "Segoe UI"; font-weight: 600; horizontal-alignment: center; }
            }
        }
    }
    forward-focus: keys;
    keys := MicFocusScope { enabled: !root.disabled; control: root.control; focus-reset: root.focus-reset;
        focus-updated(control, focused, outline) => { if !focused { root.space-held = false; } root.focus-updated(control, focused, outline); }
        key-pressed(event) => { if event.text == Key.Space { root.space-held = true; return accept; } if event.text == Key.Return { root.activated(); return accept; } return reject; }
        key-released(event) => { if event.text == Key.Space { if root.space-held { root.space-held = false; root.activated(); } return accept; } return reject; }
    }
    touch := TouchArea { enabled: !root.disabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.pointer-active = true; keys.pointer-focus(); }
            if event.kind == PointerEventKind.move && (self.mouse-x < 0px || self.mouse-y < 0px || self.mouse-x >= self.width || self.mouse-y >= self.height) { root.pointer-active = false; }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel { root.pointer-active = false; }
        }
        clicked => { root.activated(); }
    }
    if keys.outline-visible : Rectangle { x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px; background: transparent; border-radius: root.primary ? 20px : 12px; border-width: 2px; border-color: #ee68a9;
        transform-scale-x: root.outline-scale; transform-scale-y: root.outline-scale;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: !root.disabled;
    accessible-action-default => { if !root.disabled { root.activated(); } }
}

export component MicTestPanel inherits Rectangle {
    in property <MicTestView> test;
    in property <bool> active;
    in property <bool> reduced-motion;
    in property <float> pulse;
    in property <float> dot-pulse;
    in property <float> text-scale: 1;
    in property <length> screen-y;
    pure function text-top(baseline: length, ascent: length) -> length {
        return (round(round(baseline / 1px * root.text-scale) - ascent / 1px * root.text-scale) + round(root.screen-y / 1px * root.text-scale)) / root.text-scale * 1px - root.screen-y;
    }
    pure callback tr(string) -> string;
    pure callback spring(float, bool) -> float;
    out property <float> thumb-scale: root.thumb-running ? root.thumb-from + (root.thumb-target - root.thumb-from) * root.spring(clamp((animation-tick() - root.thumb-started) / root.thumb-duration, 0, 1), root.thumb-pop) : root.thumb-target;
    out property <bool> thumb-animating: root.thumb-running;
    callback thumb-updated(float, bool);
    changed thumb-scale => { root.thumb-updated(root.thumb-scale, root.thumb-running); }
    changed thumb-running => { root.thumb-updated(root.thumb-scale, root.thumb-running); }
    callback record;
    callback toggle-playback;
    callback seek(float);
    in property <int> focus-reset;
    callback focus-updated(string, bool, bool);
    callback feedback-updated(string, MicButtonFeedback);
    width: 156px;
    height: 36px + (root.test.stage == "ready" ? 27px : 0px) + (root.test.issue != "" ? 19.75px : 0px);
    background: transparent;
    private property <bool> scrubbing;
    private property <float> scrub-position;
    private property <float> shown-position: root.scrubbing ? root.scrub-position : root.test.position;
    private property <bool> ready: root.test.stage == "ready";
    private property <float> thumb-from: 1;
    private property <float> thumb-target: 1;
    private property <bool> thumb-pop;
    private property <bool> thumb-running;
    private property <duration> thumb-started;
    private property <duration> thumb-duration: root.thumb-pop ? 1880ms : 1280ms;
    function move-thumb(from: float, to: float, pop: bool) {
        root.thumb-running = false;
        root.thumb-from = from;
        root.thumb-target = to;
        root.thumb-pop = pop;
        root.thumb-started = animation-tick();
        root.thumb-running = !root.reduced-motion;
    }
    init => { if root.active && root.ready { root.move-thumb(0, 1, true); } }
    changed active => {
        if root.active && root.ready { root.move-thumb(0, 1, true); }
        if !root.active { root.scrubbing = false; root.thumb-running = false; root.thumb-target = 1; }
    }
    changed ready => {
        if root.ready && root.active { root.move-thumb(0, 1, true); }
        if !root.ready { root.scrubbing = false; root.thumb-running = false; root.thumb-target = 1; }
    }
    changed reduced-motion => { if root.reduced-motion { root.thumb-running = false; } }
    Timer { interval: 16ms; running: root.thumb-running;
        triggered => { if animation-tick() - root.thumb-started >= root.thumb-duration { root.thumb-running = false; } }
    }
    public function seek-to(seconds: float) { if root.active && root.test.duration > 0 { root.seek(clamp(seconds, 0, root.test.duration)); } }
    if root.test.stage == "ready" : Rectangle {
        x: 0px; y: 0px; width: root.width; height: 36px; border-radius: 16px; border-width: 1px; border-color: #ffffff12; background: #161618bf; clip: true;
        Rectangle { x: 12px; y: 0px; width: parent.width - 24px; height: 1px; background: #ffffff24; }
        playback := Rectangle { x: 1px; y: 0px; width: 36px; height: 36px; border-radius: 12px; background: play-touch.has-hover ? #ffffff0f : transparent;
            private property <bool> space-held;
            Image { x: 11px; y: 11px; width: 14px; height: 14px; source: root.test.playing ? @image-url("../assets/icons/test-pause.svg") : @image-url("../assets/icons/test-play.svg"); }
            forward-focus: play-keys;
            play-keys := MicFocusScope { enabled: root.active; control: "playback"; focus-reset: root.focus-reset;
                focus-updated(control, focused, outline) => { if !focused { playback.space-held = false; } root.focus-updated(control, focused, outline); }
                key-pressed(event) => { if event.text == Key.Space { playback.space-held = true; return accept; } if event.text == Key.Return { root.toggle-playback(); return accept; } return reject; }
                key-released(event) => { if event.text == Key.Space { if playback.space-held { playback.space-held = false; root.toggle-playback(); } return accept; } return reject; }
            }
            play-touch := TouchArea { enabled: root.active;
                pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { play-keys.pointer-focus(); } }
                clicked => { root.toggle-playback(); }
            }
            if play-keys.outline-visible : Rectangle { x: -4px; y: -4px; width: 44px; height: 44px; background: transparent; border-width: 2px; border-color: #ee68a9; }
            accessible-role: button;
            accessible-label: root.tr(root.test.playing ? "settings.audio.micTestPause" : "settings.audio.micTestPlay");
            accessible-enabled: root.active;
            accessible-action-default => { if root.active { root.toggle-playback(); } }
        }
        track := Rectangle { x: 39px; y: 16px; width: parent.width - 52px; height: 4px; border-radius: 2px; background: #ffffff1f;
            Rectangle { x: 0px; y: 0px; width: parent.width * clamp(root.shown-position / max(root.test.duration, 0.001), 0, 1); height: parent.height; border-radius: 2px; background: #de217c; }
            Rectangle { x: parent.width * clamp(root.shown-position / max(root.test.duration, 0.001), 0, 1) - 5px; y: -3px; width: 10px; height: 10px; border-radius: 5px; background: white;
                transform-scale-x: root.thumb-scale;
                transform-scale-y: root.thumb-scale;
                transform-origin: { x: 5px, y: 5px };
            }
        }
        seek-keys := MicFocusScope { enabled: root.active; control: "seek"; focus-reset: root.focus-reset;
            focus-updated(control, focused, outline) => { root.focus-updated(control, focused, outline); }
            key-pressed(event) => {
                if event.text == Key.LeftArrow { root.seek-to(root.test.position - 0.5); return accept; }
                if event.text == Key.RightArrow { root.seek-to(root.test.position + 0.5); return accept; }
                return reject;
            }
        }
        seek-touch := TouchArea { x: 37px; width: parent.width - 38px; height: 36px; enabled: root.active;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.move-thumb(root.thumb-scale, 1.5, false);
                    seek-keys.pointer-focus(); root.scrubbing = true;
                    root.scrub-position = clamp((self.mouse-x - 2px) / track.width, 0, 1) * root.test.duration;
                }
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel {
                    if root.scrubbing {
                        root.move-thumb(root.thumb-scale, 1, false);
                        if event.kind == PointerEventKind.up { root.scrub-position = clamp((self.mouse-x - 2px) / track.width, 0, 1) * root.test.duration; }
                        root.scrubbing = false; root.seek-to(root.scrub-position);
                    }
                }
            }
            moved => { if root.scrubbing { root.scrub-position = clamp((self.mouse-x - 2px) / track.width, 0, 1) * root.test.duration; } }
            accessible-role: slider;
            accessible-label: root.tr("settings.audio.micTestSeek");
            accessible-enabled: root.active;
            accessible-value: root.shown-position;
            accessible-value-minimum: 0;
            accessible-value-maximum: root.test.duration;
            accessible-value-step: 0.5;
            accessible-action-set-value(value) => { if value.is-float() { root.seek-to(value.to-float()); } }
            accessible-action-increment => { root.seek-to(root.test.position + 0.5); }
            accessible-action-decrement => { root.seek-to(root.test.position - 0.5); }
        }
        if seek-keys.outline-visible : Rectangle { x: 33px; y: -4px; width: parent.width - 30px; height: 44px; background: transparent; border-width: 2px; border-color: #ee68a9; }
    }
    if root.test.stage != "ready" : TestButton { x: 0px; y: 0px; width: root.width; primary: true; height: 36px; reduced-motion: root.reduced-motion; pulse: root.pulse; dot-pulse: root.dot-pulse; recording: root.test.stage == "recording";
        control: "primary"; focus-reset: root.focus-reset;
        focus-updated(control, focused, outline) => { root.focus-updated(control, focused, outline); }
        feedback-updated(control, feedback) => { root.feedback-updated(control, feedback); }
        label: root.tr(root.test.stage == "recording" ? "settings.audio.micTestTalk" : root.test.stage == "arming" ? "settings.audio.micTestArming" : "settings.audio.micTestListen");
        disabled: !root.active || root.test.stage != "idle";
        activated => { root.record(); }
    }
    if root.test.stage == "ready" : TestButton { x: (root.width - self.width) / 2; y: 42px; width: min(root.width, retake.preferred-width + 18px); height: 21px; reduced-motion: root.reduced-motion; disabled: !root.active;
        control: "retake"; focus-reset: root.focus-reset;
        focus-updated(control, focused, outline) => { root.focus-updated(control, focused, outline); }
        feedback-updated(control, feedback) => { root.feedback-updated(control, feedback); }
        label-top: root.text-top(56px, retake.font-metrics.ascent) - 42px;
        label: root.tr("settings.audio.micTestRetake"); activated => { root.record(); }
        retake := Text { visible: false; text: root.tr("settings.audio.micTestRetake"); font-size: 10px; font-family: "Segoe UI"; font-weight: 600; }
    }
    if root.test.issue != "" : Text { y: root.text-top((root.test.stage == "ready" ? 69px : 42px) + 10px, self.font-metrics.ascent); height: 13.75px; width: root.width; text: root.tr(root.test.issue == "silent" ? "settings.audio.micTestSilent" : "settings.audio.micTestFailed"); color: #ee68a9; font-size: 10px; font-family: "Segoe UI"; font-weight: 600; horizontal-alignment: center; }
}
