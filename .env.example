# Шаблон переменных окружения ZABOR / ZABOR environment variables template
#
# Скопируйте файл в .env и заполните значения. Файл .env не отслеживается git
# и не должен попадать в репозиторий, ответы агентов, логи и документацию.
#
# Copy this file to .env and fill in the values. The .env file is not tracked by
# git and must never appear in the repository, agent responses, logs or docs.

# Секрет клиентского приложения, выдаваемый сервером / client application secret issued by the server
ZABOR_CLIENT_SECRET=

# Реквизиты серверов для диагностики по SSH / server credentials for SSH diagnostics
ZABOR_SSH_USER=
ZABOR_SSH_PASSWORD=
ZABOR_SSH_DE_HOST=
ZABOR_SSH_RU_HOST=

# Необязательно: путь к приватному ключу SSH, если используется авторизация по ключу
# Optional: path to the SSH private key when key-based authentication is used
# ZABOR_SSH_KEY_PATH=%USERPROFILE%\.ssh\id_ed25519
